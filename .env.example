# ---------------------------------------------------------------------------
# 환경 변수 템플릿
#
#   이 파일에는 "키 이름"만 있고 실제 값은 없습니다.
#   로컬에서 실행할 때는 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#     Windows : copy .env.example .env
#     macOS   : cp   .env.example .env
#
#   .env 는 .gitignore 에 등록되어 있어 GitHub 에 올라가지 않습니다.
#   Vercel 배포 환경에서는 파일이 아니라
#   Project Settings > Environment Variables 에 같은 이름으로 등록합니다.
# ---------------------------------------------------------------------------

# [필수] LLM 제공자 중 "하나"만 채우면 됩니다. (둘 다 있으면 OpenAI 우선)
#   OpenAI  키 발급 : https://platform.openai.com/api-keys
#   Gemini  키 발급 : https://aistudio.google.com/apikey
OPENAI_API_KEY=
GEMINI_API_KEY=

# [선택] 사용할 모델 이름 (비워두면 아래 기본값 사용)
#   OPENAI_MODEL 기본값 : gpt-4o-mini
#   GEMINI_MODEL 기본값 : gemini-2.5-flash
OPENAI_MODEL=
GEMINI_MODEL=

# [선택] 문의 폼 내용을 외부 도구로 보낼 웹훅 주소 (보너스 과제)
#   Slack Incoming Webhook / Make / Zapier / n8n 등의 URL 을 넣습니다.
#   비워두면 문의는 서버 로그에만 남고, 사용자에게는 정상 접수로 안내합니다.
CONTACT_WEBHOOK_URL=
